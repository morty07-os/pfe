import React, { useState, useEffect, useRef } from 'react';
import { 
  Box, 
  Container, 
  Typography, 
  Paper, 
  Grid, 
  Button,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Divider,
  useTheme,
  useMediaQuery,
  Card,
  CardContent,
  IconButton,
  Tooltip,
  CircularProgress,
  Snackbar,
  Alert
} from '@mui/material';
import LocationOnIcon from '@mui/icons-material/LocationOn';
import ArrowBackIcon from '@mui/icons-material/ArrowBack';
import DirectionsCarIcon from '@mui/icons-material/DirectionsCar';
import AccessTimeIcon from '@mui/icons-material/AccessTime';
import MyLocationIcon from '@mui/icons-material/MyLocation';
import FilterAltIcon from '@mui/icons-material/FilterAlt';
import RefreshIcon from '@mui/icons-material/Refresh';
import Navbar from '../components/Navbar';
import QuickSearch from '../components/QuickSearch';
import { useNavigate, useParams } from 'react-router-dom';

// Import Leaflet CSS and components
import 'leaflet/dist/leaflet.css';
import L from 'leaflet';
import { MapContainer, TileLayer, Marker, Popup, useMap, useMapEvents } from 'react-leaflet';

// Fix for default marker icons in React-Leaflet
delete L.Icon.Default.prototype._getIconUrl;
L.Icon.Default.mergeOptions({
  iconRetinaUrl: 'https://unpkg.com/leaflet@1.7.1/dist/images/marker-icon-2x.png',
  iconUrl: 'https://unpkg.com/leaflet@1.7.1/dist/images/marker-icon.png',
  shadowUrl: 'https://unpkg.com/leaflet@1.7.1/dist/images/marker-shadow.png',
});

// Custom car marker icon
const carIcon = new L.Icon({
  iconUrl: 'https://cdn-icons-png.flaticon.com/512/3097/3097144.png',
  iconSize: [32, 32],
  iconAnchor: [16, 32],
  popupAnchor: [0, -32]
});

// Custom highlighted car marker icon
const highlightedCarIcon = new L.Icon({
  iconUrl: 'https://cdn-icons-png.flaticon.com/512/3097/3097144.png',
  iconSize: [40, 40],
  iconAnchor: [20, 40],
  popupAnchor: [0, -40],
  className: 'highlighted-marker'
});

// Custom user location marker icon
const userLocationIcon = new L.Icon({
  iconUrl: 'https://cdn-icons-png.flaticon.com/512/1946/1946429.png',
  iconSize: [32, 32],
  iconAnchor: [16, 16],
  popupAnchor: [0, -16]
});

// Component to handle map events and user location
function LocationMarker({ userLocation, setUserLocation }) {
  const map = useMap();
  
  useEffect(() => {
    if (userLocation) {
      map.flyTo(userLocation, 14);
    }
  }, [userLocation, map]);
  
  return userLocation ? (
    <Marker position={userLocation} icon={userLocationIcon}>
      <Popup>You are here</Popup>
    </Marker>
  ) : null;
}

// Main MapPage component
const MapPage = () => {
  const navigate = useNavigate();
  const { wilaya } = useParams();
  const mapRef = useRef(null);
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down('md'));
  
  // State for cars, locations, and UI
  const [allCars, setAllCars] = useState([]);
  const [selectedLocation, setSelectedLocation] = useState(null);
  const [userLocation, setUserLocation] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [highlightedCar, setHighlightedCar] = useState(null);
  const [showAlert, setShowAlert] = useState(false);
  const [alertMessage, setAlertMessage] = useState('');
  const [alertSeverity, setAlertSeverity] = useState('info');
  
  // Get highlighted car from localStorage if available
  useEffect(() => {
    const storedCar = localStorage.getItem('selectedCar');
    if (storedCar) {
      try {
        const parsedCar = JSON.parse(storedCar);
        setHighlightedCar(parsedCar);
        // Clear from localStorage after retrieving
        localStorage.removeItem('selectedCar');
      } catch (error) {
        console.error('Error parsing stored car:', error);
      }
    }
  }, []);
  
  // Fetch all cars when component mounts
  useEffect(() => {
    fetchAllCars();
  }, []);
  
  // Fetch cars from API
  const fetchAllCars = async () => {
    setLoading(true);
    setError(null);
    
    try {
      const response = await fetch('http://localhost:5001/api/cars/getcars');
      if (!response.ok) {
        throw new Error('Failed to fetch cars');
      }
      
      const data = await response.json();
      
      // Filter by wilaya if specified
      const filteredCars = wilaya ? data.filter(car => car.wilaya === wilaya) : data;
      
      setAllCars(filteredCars);
      
      // If there's a highlighted car, find and select it
      if (highlightedCar) {
        const found = filteredCars.find(car => car._id === highlightedCar.carId);
        if (found) {
          setSelectedLocation(found);
          showNotification('Car found on map!', 'success');
        }
      }
    } catch (error) {
      console.error('Error fetching cars:', error);
      setError(error.message);
      showNotification('Failed to load cars. Please try again.', 'error');
    } finally {
      setLoading(false);
    }
  };
  
  // Handle location selection
  const handleLocationSelect = (location) => {
    setSelectedLocation(location);
    
    // Center map on selected location
    if (location.location && location.location.coordinates) {
      const { lat, lng } = location.location.coordinates;
      if (mapRef.current) {
        mapRef.current.flyTo([lat, lng], 15);
      }
    }
  };
  
  // Get user's current location
  const getUserLocation = () => {
    setLoading(true);
    
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (position) => {
          const { latitude, longitude } = position.coords;
          setUserLocation({ lat: latitude, lng: longitude });
          setLoading(false);
          showNotification('Your location found!', 'success');
        },
        (error) => {
          console.error('Error getting location:', error);
          setLoading(false);
          showNotification('Could not get your location. Please check your browser permissions.', 'error');
        }
      );
    } else {
      setLoading(false);
      showNotification('Geolocation is not supported by your browser.', 'error');
    }
  };
  
  // Handle going back
  const handleGoBack = () => {
    navigate('/offers');
  };
  
  // Show notification
  const showNotification = (message, severity) => {
    setAlertMessage(message);
    setAlertSeverity(severity);
    setShowAlert(true);
  };
  
  // Close alert
  const handleCloseAlert = () => {
    setShowAlert(false);
  };
  
  // Get coordinates for a car
  const getCarCoordinates = (car) => {
    // If car has specific location coordinates, use those
    if (car.location && car.location.coordinates && car.location.coordinates.lat && car.location.coordinates.lng) {
      return [car.location.coordinates.lat, car.location.coordinates.lng];
    }
    
    // Otherwise, use wilaya coordinates with a small random offset for visual separation
    const wilayaCoords = getWilayaCoordinates(car.wilaya);
    if (wilayaCoords) {
      // Add small random offset to avoid markers stacking exactly on top of each other
      const latOffset = (Math.random() - 0.5) * 0.02;
      const lngOffset = (Math.random() - 0.5) * 0.02;
      return [wilayaCoords[0] + latOffset, wilayaCoords[1] + lngOffset];
    }
    
    // Default to center of Algeria if no coordinates found
    return [36.7372, 3.0865]; // Algiers coordinates
  };
  
  // Get coordinates for a wilaya
  const getWilayaCoordinates = (wilayaName) => {
    // Map of wilaya names to coordinates
    const wilayaCoordinates = {
      'Adrar': [27.8742, -0.2993],
      'Chlef': [36.1647, 1.3367],
      'Laghouat': [33.8080, 2.8799],
      'Oum El Bouaghi': [35.8750, 7.1130],
      'Batna': [35.5550, 6.1750],
      'Béjaïa': [36.7510, 5.0560],
      'Biskra': [34.8500, 5.7280],
      'Béchar': [31.6230, -2.2200],
      'Blida': [36.4700, 2.8300],
      'Bouira': [36.3800, 3.9000],
      'Tamanrasset': [22.7850, 5.5230],
      'Tébessa': [35.4040, 8.1240],
      'Tlemcen': [34.8880, -1.3150],
      'Tiaret': [35.3700, 1.3200],
      'Tizi Ouzou': [36.7100, 4.0470],
      'Alger': [36.7372, 3.0865],
      'Djelfa': [34.6700, 3.2500],
      'Jijel': [36.8000, 5.7600],
      'Sétif': [36.1900, 5.4100],
      'Saïda': [34.8300, 0.1500],
      'Skikda': [36.8800, 6.9000],
      'Sidi Bel Abbès': [35.2000, -0.6300],
      'Annaba': [36.9000, 7.7700],
      'Guelma': [36.4600, 7.4300],
      'Constantine': [36.3650, 6.6147],
      'Médéa': [36.2700, 2.7500],
      'Mostaganem': [35.9300, 0.0900],
      'M\'Sila': [35.7000, 4.5400],
      'Mascara': [35.4000, 0.1400],
      'Ouargla': [31.9500, 5.3300],
      'Oran': [35.6969, -0.6331],
      'El Bayadh': [33.6800, 1.0200],
      'Illizi': [26.5000, 8.4800],
      'Bordj Bou Arréridj': [36.0700, 4.7600],
      'Boumerdès': [36.7600, 3.4800],
      'El Tarf': [36.7670, 8.3130],
      'Tindouf': [27.6730, -8.1430],
      'Tissemsilt': [35.6070, 1.8110],
      'El Oued': [33.3680, 6.8590],
      'Khenchela': [35.4300, 7.1430],
      'Souk Ahras': [36.2800, 7.9510],
      'Tipaza': [36.5890, 2.4510],
      'Mila': [36.4500, 6.2650],
      'Aïn Defla': [36.2640, 1.9680],
      'Naâma': [33.2670, -0.3130],
      'Aïn Témouchent': [35.3040, -1.1400],
      'Ghardaïa': [32.4900, 3.6740],
      'Relizane': [35.7370, 0.5560]
    };
    
    return wilayaCoordinates[wilayaName] || null;
  };

  return (
    <Box sx={{ 
      minHeight: '100vh',
      display: 'flex',
      flexDirection: 'column'
    }}>
      <Navbar />
      <QuickSearch />
      
      {/* Alert for notifications */}
      <Snackbar 
        open={showAlert} 
        autoHideDuration={6000} 
        onClose={handleCloseAlert}
        anchorOrigin={{ vertical: 'top', horizontal: 'center' }}
      >
        <Alert onClose={handleCloseAlert} severity={alertSeverity} sx={{ width: '100%' }}>
          {alertMessage}
        </Alert>
      </Snackbar>
      
      <Box sx={{ 
        flexGrow: 1,
        position: 'relative'
      }}>
        <Container maxWidth="xl" sx={{ pt: 2 }}>
          <Box sx={{ mb: 2, display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
              <Button 
                variant="outlined" 
                startIcon={<ArrowBackIcon />}
                onClick={handleGoBack}
                sx={{
                  borderColor: '#475569',
                  color: '#475569',
                  '&:hover': {
                    borderColor: '#334155',
                    bgcolor: 'rgba(71, 85, 105, 0.04)'
                  }
                }}
              >
                Back to Offers
              </Button>
              <Typography variant="h5" component="h1" sx={{ fontWeight: 600, color: '#1e293b' }}>
                {wilaya ? `${wilaya} Car Locations` : 'All Car Locations'}
              </Typography>
            </Box>
            
            {/* User location and refresh buttons */}
            <Box sx={{ display: 'flex', gap: 1 }}>
              <Tooltip title="Find my location">
                <IconButton 
                  onClick={getUserLocation}
                  disabled={loading}
                  sx={{ 
                    bgcolor: '#f1f5f9', 
                    color: '#475569',
                    '&:hover': { bgcolor: '#e2e8f0', color: '#334155' }
                  }}
                >
                  {loading ? <CircularProgress size={24} /> : <MyLocationIcon />}
                </IconButton>
              </Tooltip>
              <Tooltip title="Refresh car locations">
                <IconButton 
                  onClick={() => window.location.reload()}
                  sx={{ 
                    bgcolor: '#f1f5f9', 
                    color: '#475569',
                    '&:hover': { bgcolor: '#e2e8f0', color: '#334155' }
                  }}
                >
                  <RefreshIcon />
                </IconButton>
              </Tooltip>
            </Box>
          </Box>
          
          <Grid container spacing={4} direction={{ xs: 'column-reverse', md: 'row' }}>
            {/* Car list */}
            <Grid item xs={12} md={3}>
              <Paper 
                elevation={2} 
                sx={{ 
                  borderRadius: 2,
                  overflow: 'hidden',
                  height: '100%',
                  maxHeight: { md: 600 },
                  boxShadow: '0 4px 12px rgba(0, 0, 0, 0.1)'
                }}
              >
                <Box sx={{ 
                  background: 'linear-gradient(90deg, #475569 0%, #334155 100%)', 
                  color: 'white',
                  p: 2,
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center'
                }}>
                  <Typography variant="h6">
                    Available Cars
                  </Typography>
                  <Typography variant="body2">
                    {allCars.length} cars
                  </Typography>
                </Box>
                
                <Box sx={{ maxHeight: { md: 'calc(600px - 56px)' }, overflow: 'auto' }}>
                  {loading ? (
                    <Box sx={{ display: 'flex', justifyContent: 'center', p: 4 }}>
                      <CircularProgress />
                    </Box>
                  ) : error ? (
                    <Box sx={{ p: 3, textAlign: 'center' }}>
                      <Typography color="error">{error}</Typography>
                      <Button 
                        variant="outlined" 
                        color="primary" 
                        sx={{ mt: 2 }}
                        onClick={() => window.location.reload()}
                      >
                        Retry
                      </Button>
                    </Box>
                  ) : (
                    <List sx={{ p: 0 }}>
                      {allCars.map((car, index) => (
                        <React.Fragment key={car._id || index}>
                          {index > 0 && <Divider />}
                          <ListItem 
                            button
                            selected={selectedLocation?._id === car._id}
                            onClick={() => handleLocationSelect(car)}
                            sx={{
                              py: 2,
                              '&.Mui-selected': {
                                bgcolor: '#f1f5f9',
                                '&:hover': {
                                  bgcolor: '#e2e8f0'
                                }
                              }
                            }}
                          >
                            <ListItemIcon>
                              <DirectionsCarIcon sx={{ 
                                color: selectedLocation?._id === car._id ? '#334155' : '#64748b',
                                transform: highlightedCar?.carId === car._id ? 'scale(1.2)' : 'none',
                                transition: 'all 0.3s ease'
                              }} />
                            </ListItemIcon>
                            <ListItemText 
                              primary={
                                <Typography variant="subtitle1" sx={{ 
                                  fontWeight: 600, 
                                  color: '#334155',
                                  display: 'flex',
                                  alignItems: 'center',
                                  gap: 1
                                }}>
                                  {car.title || car.carName || 'Car Listing'}
                                  {highlightedCar?.carId === car._id && (
                                    <Box sx={{ 
                                      bgcolor: '#3b82f6', 
                                      color: 'white', 
                                      fontSize: '0.7rem',
                                      px: 1,
                                      py: 0.2,
                                      borderRadius: 1,
                                      fontWeight: 'bold'
                                    }}>
                                      Selected
                                    </Box>
                                  )}
                                </Typography>
                              }
                              secondary={
                                <Box sx={{ mt: 0.5 }}>
                                  <Typography variant="body2" sx={{ color: '#64748b', mb: 0.5 }}>
                                    {car.wilaya || 'Unknown Location'}
                                    {car.location?.name && ` - ${car.location.name}`}
                                  </Typography>
                                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                                    <DirectionsCarIcon sx={{ fontSize: 16, color: '#64748b' }} />
                                    <Typography variant="caption" color="text.secondary">
                                      {car.brand} {car.model}
                                    </Typography>
                                  </Box>
                                </Box>
                              }
                            />
                          </ListItem>
                        </React.Fragment>
                      ))}
                    </List>
                  )}
                </Box>
              </Paper>
            </Grid>
            
            {/* Map */}
            <Grid item xs={12} md={9}>
              <Paper 
                elevation={2} 
                sx={{ 
                  borderRadius: 2,
                  overflow: 'hidden',
                  height: { xs: 400, md: 600 },
                  boxShadow: '0 4px 12px rgba(0, 0, 0, 0.1)'
                }}
              >
                <MapContainer 
                  center={[36.7372, 3.0865]} // Default to Algiers
                  zoom={wilaya ? 10 : 6}
                  style={{ height: '100%', width: '100%' }}
                  whenCreated={mapInstance => {
                    mapRef.current = mapInstance;
                  }}
                >
                  <TileLayer
                    attribution='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                    url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
                  />
                  
                  {/* User location marker */}
                  <LocationMarker 
                    userLocation={userLocation} 
                    setUserLocation={setUserLocation} 
                  />
                  
                  {/* Car markers */}
                  {allCars.map((car) => {
                    const coordinates = getCarCoordinates(car);
                    const isHighlighted = highlightedCar?.carId === car._id;
                    const isSelected = selectedLocation?._id === car._id;
                    
                    return (
                      <Marker 
                        key={car._id} 
                        position={coordinates}
                        icon={isHighlighted || isSelected ? highlightedCarIcon : carIcon}
                        eventHandlers={{
                          click: () => {
                            setSelectedLocation(car);
                          }
                        }}
                      >
                        <Popup>
                          <Box sx={{ maxWidth: 250 }}>
                            <Typography variant="subtitle1" sx={{ fontWeight: 600, mb: 1 }}>
                              {car.title || car.carName || 'Car Listing'}
                            </Typography>
                            
                            <Typography variant="body2" sx={{ mb: 1 }}>
                              <strong>Brand:</strong> {car.brand} {car.model}
                            </Typography>
                            
                            <Typography variant="body2" sx={{ mb: 1 }}>
                              <strong>Location:</strong> {car.wilaya}
                              {car.location?.name && ` - ${car.location.name}`}
                            </Typography>
                            
                            <Typography variant="body2" sx={{ mb: 1 }}>
                              <strong>Price:</strong> {car.price} DZD/day
                            </Typography>
                            
                            <Button 
                              variant="contained" 
                              fullWidth
                              size="small"
                              sx={{ 
                                mt: 1, 
                                bgcolor: '#475569',
                                '&:hover': { bgcolor: '#334155' }
                              }}
                              onClick={() => {
                                navigate(`/car/${car._id}`);
                              }}
                            >
                              View Details
                            </Button>
                          </Box>
                        </Popup>
                      </Marker>
                    );
                  })}
                </MapContainer>
              </Paper>
            </Grid>
          </Grid>
        </Container>
      </Box>
    </Box>
  );
};

export default MapPage;
